# ===========================
# Konfigurasi Database
# ===========================
DB_USER=postgres
DB_HOST=localhost
DB_NAME=inventaris_tonasa
DB_PASSWORD=your_database_password
DB_PORT=5432

# ===========================
# JWT Authentication
# Gunakan string acak minimal 64 karakter untuk production
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================
SECRET_KEY=your_secret_key_here

# ===========================
# Akun Admin Default (digunakan saat pertama kali menjalankan sistem)
# ===========================
ADMIN_EMAIL=admin@contoh.com
ADMIN_PASSWORD=your_admin_password

# ===========================
# CORS Configuration
# Untuk production, ganti dengan domain spesifik (misal: https://inventaris.tonasa.co.id)
# ===========================
CORS_ORIGIN=*

# ===========================
# Kontrol Registrasi Publik
# Set 'false' untuk menonaktifkan registrasi mandiri
# ===========================
ALLOW_PUBLIC_REGISTRATION=true
